terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.40"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket  = "healthkicks-tofu-state-eu-west-1-693906847467"
    key     = "production/terraform.tfstate"
    region  = "eu-west-1"
    encrypt = true
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "HealthKicks"
      Environment = var.environment
      ManagedBy   = "OpenTofu"
    }
  }
}

provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"

  default_tags {
    tags = {
      Project     = "HealthKicks"
      Environment = var.environment
      ManagedBy   = "OpenTofu"
    }
  }
}

# Reads CLOUDFLARE_API_TOKEN automatically from the environment
provider "cloudflare" {}
